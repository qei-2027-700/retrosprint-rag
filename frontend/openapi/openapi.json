{
  "components": {
    "schemas": {
      "Answer": {
        "properties": {
          "citation_ids": {
            "items": {
              "type": "string"
            },
            "title": "Citation Ids",
            "type": "array"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "citation_ids"
        ],
        "title": "Answer",
        "type": "object"
      },
      "Answered": {
        "properties": {
          "answer": {
            "$ref": "#/components/schemas/Answer"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "title": "Citations",
            "type": "array"
          },
          "coverage": {
            "$ref": "#/components/schemas/Coverage"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "mode": {
            "const": "fake",
            "default": "fake",
            "title": "Mode",
            "type": "string"
          },
          "reflection_month": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reflection Month"
          },
          "retrieval_mode": {
            "enum": [
              "monthly_reflection",
              "related_search"
            ],
            "title": "Retrieval Mode",
            "type": "string"
          },
          "status": {
            "const": "answered",
            "default": "answered",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "retrieval_mode",
          "reflection_month",
          "coverage",
          "answer",
          "citations"
        ],
        "title": "Answered",
        "type": "object"
      },
      "Citation": {
        "properties": {
          "content_version": {
            "title": "Content Version",
            "type": "string"
          },
          "document_id": {
            "title": "Document Id",
            "type": "string"
          },
          "document_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Document Name"
          },
          "drive_url": {
            "title": "Drive Url",
            "type": "null"
          },
          "heading": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Heading"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "locator": {
            "$ref": "#/components/schemas/Locator"
          },
          "original_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Original Text"
          },
          "page": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page"
          },
          "quote": {
            "title": "Quote",
            "type": "string"
          },
          "reflection_month": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reflection Month"
          }
        },
        "required": [
          "id",
          "document_id",
          "document_name",
          "content_version",
          "reflection_month",
          "heading",
          "quote",
          "original_text",
          "locator"
        ],
        "title": "Citation",
        "type": "object"
      },
      "Coverage": {
        "properties": {
          "checked_at": {
            "title": "Checked At",
            "type": "string"
          },
          "complete": {
            "title": "Complete",
            "type": "boolean"
          },
          "documents_retrieved": {
            "title": "Documents Retrieved",
            "type": "integer"
          },
          "documents_used": {
            "title": "Documents Used",
            "type": "integer"
          },
          "last_sync_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Sync At"
          },
          "omitted": {
            "title": "Omitted",
            "type": "boolean"
          },
          "scope": {
            "enum": [
              "month_documents",
              "search_matches"
            ],
            "title": "Scope",
            "type": "string"
          }
        },
        "required": [
          "scope",
          "complete",
          "omitted",
          "documents_retrieved",
          "documents_used",
          "checked_at"
        ],
        "title": "Coverage",
        "type": "object"
      },
      "EchoRequest": {
        "properties": {
          "message": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "EchoRequest",
        "type": "object"
      },
      "EchoResponse": {
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "EchoResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthResponse",
        "type": "object"
      },
      "InsufficientEvidence": {
        "properties": {
          "answer": {
            "title": "Answer",
            "type": "null"
          },
          "citations": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "title": "Citations",
            "type": "array"
          },
          "coverage": {
            "$ref": "#/components/schemas/Coverage"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "mode": {
            "const": "fake",
            "default": "fake",
            "title": "Mode",
            "type": "string"
          },
          "reflection_month": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reflection Month"
          },
          "retrieval_mode": {
            "enum": [
              "monthly_reflection",
              "related_search"
            ],
            "title": "Retrieval Mode",
            "type": "string"
          },
          "status": {
            "default": "insufficient_evidence",
            "enum": [
              "insufficient_evidence",
              "no_documents",
              "stale_evidence",
              "input_limit_exceeded"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "retrieval_mode",
          "reflection_month",
          "coverage"
        ],
        "title": "InsufficientEvidence",
        "type": "object"
      },
      "Locator": {
        "properties": {
          "end": {
            "title": "End",
            "type": "integer"
          },
          "start": {
            "title": "Start",
            "type": "integer"
          }
        },
        "required": [
          "start",
          "end"
        ],
        "title": "Locator",
        "type": "object"
      },
      "QuestionError": {
        "properties": {
          "code": {
            "const": "question_processing_failed",
            "default": "question_processing_failed",
            "title": "Code",
            "type": "string"
          },
          "message": {
            "default": "回答処理に失敗しました。もう一度送信してください。",
            "title": "Message",
            "type": "string"
          }
        },
        "title": "QuestionError",
        "type": "object"
      },
      "QuestionRequest": {
        "additionalProperties": false,
        "properties": {
          "question": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          },
          "reflection_month": {
            "anyOf": [
              {
                "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reflection Month"
          },
          "retrieval_mode": {
            "default": "related_search",
            "enum": [
              "monthly_reflection",
              "related_search"
            ],
            "title": "Retrieval Mode",
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "title": "QuestionRequest",
        "type": "object"
      },
      "RetrievalError": {
        "properties": {
          "code": {
            "enum": [
              "retrieval_failed",
              "generation_failed"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "RetrievalError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Retrosprint RAG API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/questions": {
      "post": {
        "operationId": "ask_question",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuestionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/Answered"
                    },
                    {
                      "$ref": "#/components/schemas/InsufficientEvidence"
                    }
                  ],
                  "title": "Response Ask Question"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuestionError"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RetrievalError"
                }
              }
            },
            "description": "Bad Gateway"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RetrievalError"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Question"
      }
    },
    "/api/v1/dev/echo": {
      "post": {
        "operationId": "echo_message",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EchoRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EchoResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Echo"
      }
    },
    "/health": {
      "get": {
        "operationId": "get_health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    }
  }
}
