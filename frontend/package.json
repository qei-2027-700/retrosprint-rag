{
  "name": "@retrosprint/frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host localhost --port 3000",
    "generate": "nuxt generate",
    "typecheck": "nuxt typecheck && tsc --project tests/tsconfig.json",
    "api:generate": "openapi-typescript openapi/openapi.json -o app/api/generated/schema.d.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "nuxt": "4.6.2",
    "vue": "3.5.44",
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.13",
    "openapi-typescript": "7.13.0",
    "@playwright/test": "1.64.1",
    "vitest": "4.1.9",
    "@types/node": "24.12.0"
  }
}
